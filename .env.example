# Required by the Claude Agent normalizer.
ANTHROPIC_API_KEY=
# Required for a multi-workspace/personal API key; use a wrkspc_... ID.
ANTHROPIC_WORKSPACE_ID=
# Optional path to a current Claude Code CLI. Multi-workspace headers require
# Claude Code 2.1.227 or newer.
CLAUDE_CLI_PATH=

# Optional runtime controls.
NORMALIZER_MODEL=claude-haiku-4-5
NORMALIZER_CONCURRENCY=5
NORMALIZER_MAX_TURNS=12
NORMALIZER_MAX_BUDGET_USD=1.0
